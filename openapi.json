{
  "openapi": "3.1.0",
  "info": {
    "title": "IBLOG AI Assistant",
    "description": "AI Assistant microservice for IBLOG e-learning platform",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/chat/": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Chat",
        "description": "Text-based conversation endpoint.\nReceives user message, performs RAG retrieval, returns AI response.",
        "operationId": "chat_api_v1_chat__post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/audio/": {
      "post": {
        "tags": [
          "audio"
        ],
        "summary": "Process Audio",
        "description": "Audio processing endpoint.\nReceives audio blob, transcribes via Whisper, processes through RAG pipeline.",
        "operationId": "process_audio_api_v1_audio__post",
        "parameters": [
          {
            "name": "session_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          },
          {
            "name": "tenant_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "title": "Tenant Id"
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Language",
              "default": "ar-MA"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_process_audio_api_v1_audio__post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AudioResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/quiz/": {
      "post": {
        "tags": [
          "quiz"
        ],
        "summary": "Generate Quiz",
        "description": "Quiz generation endpoint.\nRetrieves relevant course material via RAG, generates pedagogical quiz questions.",
        "operationId": "generate_quiz_api_v1_quiz__post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuizRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuizResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AudioResponse": {
        "properties": {
          "transcription": {
            "type": "string",
            "title": "Transcription",
            "description": "Transcribed text from audio"
          },
          "response": {
            "type": "string",
            "title": "Response",
            "description": "AI assistant response to transcribed query"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id",
            "description": "Conversation session ID"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources",
            "description": "Retrieved document sources"
          }
        },
        "type": "object",
        "required": [
          "transcription",
          "response",
          "session_id"
        ],
        "title": "AudioResponse"
      },
      "Body_process_audio_api_v1_audio__post": {
        "properties": {
          "audio": {
            "type": "string",
            "format": "binary",
            "title": "Audio"
          }
        },
        "type": "object",
        "required": [
          "audio"
        ],
        "title": "Body_process_audio_api_v1_audio__post"
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Message",
            "description": "User message"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id",
            "description": "Conversation session ID"
          },
          "tenant_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tenant Id",
            "description": "Company/tenant identifier"
          },
          "language": {
            "$ref": "#/components/schemas/Language",
            "description": "Response language",
            "default": "fr"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "response": {
            "type": "string",
            "title": "Response",
            "description": "AI assistant response"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id",
            "description": "Conversation session ID"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources",
            "description": "Retrieved document sources"
          },
          "tokens_used": {
            "type": "integer",
            "title": "Tokens Used",
            "description": "Total tokens consumed",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "response",
          "session_id"
        ],
        "title": "ChatResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Language": {
        "type": "string",
        "enum": [
          "fr",
          "en",
          "ar-MA"
        ],
        "title": "Language"
      },
      "QuizQuestion": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question",
            "description": "Question text"
          },
          "options": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 6,
            "minItems": 2,
            "title": "Options",
            "description": "Answer options"
          },
          "correct_index": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Correct Index",
            "description": "Index of correct answer"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation",
            "description": "Explanation of the correct answer",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "question",
          "options",
          "correct_index"
        ],
        "title": "QuizQuestion"
      },
      "QuizRequest": {
        "properties": {
          "topic": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Topic",
            "description": "Topic to generate quiz about"
          },
          "num_questions": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Num Questions",
            "description": "Number of questions to generate",
            "default": 5
          },
          "tenant_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tenant Id",
            "description": "Company/tenant identifier"
          },
          "language": {
            "$ref": "#/components/schemas/Language",
            "description": "Quiz language",
            "default": "fr"
          }
        },
        "type": "object",
        "required": [
          "topic"
        ],
        "title": "QuizRequest"
      },
      "QuizResponse": {
        "properties": {
          "questions": {
            "items": {
              "$ref": "#/components/schemas/QuizQuestion"
            },
            "type": "array",
            "title": "Questions",
            "description": "Generated quiz questions"
          },
          "topic": {
            "type": "string",
            "title": "Topic",
            "description": "Quiz topic"
          },
          "total_questions": {
            "type": "integer",
            "title": "Total Questions",
            "description": "Total number of questions"
          }
        },
        "type": "object",
        "required": [
          "questions",
          "topic",
          "total_questions"
        ],
        "title": "QuizResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}