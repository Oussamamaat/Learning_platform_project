        ],
        "summary": "Get Source",
        "operationId": "get_source_api_v1_ingest_sources__source_id__get",
        "parameters": [
          {
            "name": "source_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Source Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceFileOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "ingest"
        ],
        "summary": "Update Source",
        "operationId": "update_source_api_v1_ingest_sources__source_id__patch",
        "parameters": [
          {
            "name": "source_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Source Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SourceToggleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceFileOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "ingest"
        ],
        "summary": "Delete Source",
        "operationId": "delete_source_api_v1_ingest_sources__source_id__delete",
        "parameters": [
          {
            "name": "source_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Source Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/video/generate": {
      "post": {
        "tags": [
          "video"
        ],
        "summary": "Generate Video",
        "description": "Our side: create a pending job and return immediately -- the caller\npolls GET /jobs/{id} for the result, same pattern as file upload.",
        "operationId": "generate_video_api_v1_video_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoGenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoJobOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/video/jobs": {
      "get": {
        "tags": [
          "video"
        ],
        "summary": "List Jobs",
        "description": "Video worker's side: poll with ?status=pending to claim work.",
        "operationId": "list_jobs_api_v1_video_jobs_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/VideoJobStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/VideoJobOut"
                  },
                  "title": "Response List Jobs Api V1 Video Jobs Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/video/jobs/{job_id}": {
      "get": {
        "tags": [
          "video"
        ],
        "summary": "Get Job",
        "description": "Our side: poll for the result.",
        "operationId": "get_job_api_v1_video_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoJobOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "video"
        ],
        "summary": "Update Job",
        "description": "Video worker's side: report progress/result. Required fields per\nstatus: 'ready' -> video_url, 'error' -> error_message.",
        "operationId": "update_job_api_v1_video_jobs__job_id__patch",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoJobUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoJobOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AudioResponse": {
        "properties": {
          "transcription": {
            "type": "string",
            "title": "Transcription",
            "description": "Transcribed text from audio"
          },
          "response": {
            "type": "string",
            "title": "Response",
            "description": "AI assistant response to transcribed query"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id",
            "description": "Conversation session ID"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources",
            "description": "Retrieved document sources"
          }
        },
        "type": "object",
        "required": [
          "transcription",
          "response",
          "session_id"
        ],
        "title": "AudioResponse"
      },
      "Body_process_audio_api_v1_audio__post": {
        "properties": {
          "audio": {
            "type": "string",
            "format": "binary",
            "title": "Audio"
          }
        },
        "type": "object",
        "required": [
          "audio"
        ],
        "title": "Body_process_audio_api_v1_audio__post"
      },
      "Body_upload_sources_api_v1_ingest_upload_post": {
        "properties": {
          "files": {
            "items": {
              "type": "string",
              "format": "binary"
            },
            "type": "array",
            "title": "Files"
          },
          "domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Domain"
          }
        },
        "type": "object",
        "required": [
          "files"
        ],
        "title": "Body_upload_sources_api_v1_ingest_upload_post"
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Message",
            "description": "User message"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id",
            "description": "Conversation session ID"
          },
          "tenant_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tenant Id",
            "description": "Company/tenant identifier"
          },
          "domain": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Domain"
              },
              {
                "type": "null"
              }
            ],
            "description": "Domain for tutoring context. Explicit value (e.g. a course-module page that already knows its own domain) is authoritative and skips auto-routing entirely; omitted routes automatically via app.services.routing (retrieval-as-router, then the tenant default) -- see ChatResponse.domain_source for what was chosen."
          },
          "language": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Language"
              },
              {
                "type": "null"
              }
            ],
            "description": "Response language. Explicit value is authoritative for both retrieval and the response; omitted routes automatically via app.services.routing (script detection, an in-message instruction like 'réponds en darija', or a sticky prior override) -- see ChatResponse.language."
          },
          "active_source_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Source Ids",
            "description": "Which of the tenant's uploaded sources (app/routers/ingest.py) may ground this turn's answer. A NARROWING hint only, like tenant_id -- app.services.sources.active_source_ids intersects this against server-side (status='ready' AND enabled) state, never widens it, so a stale client can't resurrect a source the tenant just disabled. The tenant's always-on global corpus is never affected by this field. Omitted means every currently-enabled uploaded source is eligible."
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "response": {
            "type": "string",
            "title": "Response",
            "description": "AI assistant response"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id",
            "description": "Conversation session ID"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources",
            "description": "Retrieved document sources"
          },
          "tokens_used": {
            "type": "integer",
            "title": "Tokens Used",
            "description": "Total tokens consumed",
            "default": 0
          },
          "domain": {
            "type": "string",
            "title": "Domain",
            "description": "The domain this turn was actually answered in"
          },
          "domain_source": {
            "type": "string",
            "title": "Domain Source",
            "description": "How `domain` was resolved: 'page_context' (caller supplied it), 'retrieval' (auto-routed by a similarity-weighted vote over unfiltered top chunks), 'pinned' (reused this session's existing segment), 'no_match' (the vote ran and NOTHING cleared the threshold -- the query is out of corpus, and this response is a deterministic refusal), or 'tenant_default' (routing could form no opinion at all: disk backend, or the vote's own search failed)."
          },
          "language": {
            "type": "string",
            "title": "Language",
            "description": "The response language actually used: 'fr' or 'darija'."
          },
          "prior_questions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Prior Questions",
            "description": "Socratic questions the tutor already asked in turns that fell out of the replayed history window (deterministic extraction, not a model summary) -- for the UI to show 'already asked' state without the server re-asking them in the prompt."
          },
          "cross_language": {
            "type": "boolean",
            "title": "Cross Language",
            "description": "True when retrieval could not find enough same-language source material (ADR 0002 decision 5) and fell back across the language line -- the answer is still grounded and in the requested language, but the UI should surface that the underlying sources are in a different script.",
            "default": false
          },
          "degraded": {
            "type": "boolean",
            "title": "Degraded",
            "description": "True when pgvector retrieval raised and this answer fell back to the disk backend (app/routers/chat.py's _retrieve_context) -- which knows nothing about tenant uploads. The answer is still grounded in the built-in corpus, but any uploaded sources are silently absent from it until Postgres recovers; the UI should say so rather than let a confident, cited-looking answer imply otherwise.",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "response",
          "session_id",
          "domain",
          "domain_source",
          "language"
        ],
        "title": "ChatResponse"
      },
      "DemoRequest": {
        "properties": {
          "language": {
            "type": "string",
            "title": "Language"
          },
          "turn": {
            "type": "integer",
            "title": "Turn"
          }
        },
        "type": "object",
        "required": [
          "language",
          "turn"
        ],
        "title": "DemoRequest"
      },
      "Domain": {
        "type": "string",
        "enum": [
          "industrial",
          "securite",
          "blockchain"
        ],
        "title": "Domain"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Language": {
        "type": "string",
        "enum": [
          "fr",
          "en",
          "ar-MA"
        ],
        "title": "Language"
      },
      "QuizQuestion": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question",
            "description": "Question text"
          },
          "options": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 6,
            "minItems": 2,
            "title": "Options",
            "description": "Answer options"
          },
          "correct_index": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Correct Index",
            "description": "Index of correct answer"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation",
            "description": "Explanation of the correct answer",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "question",
          "options",
          "correct_index"
        ],
        "title": "QuizQuestion"
      },
      "QuizRequest": {
        "properties": {
          "topic": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Topic",
            "description": "Topic to generate quiz about"
          },
          "num_questions": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Num Questions",
            "description": "Number of questions to generate",
            "default": 5
          },
          "tenant_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tenant Id",
            "description": "Company/tenant identifier"
          },
          "domain": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Domain"
              },
              {
                "type": "null"
              }
            ],
            "description": "Domain to ground the quiz in. Explicit value is authoritative and enforced at retrieval time (was previously hardcoded server-side to 'industrial' with no domain filter at all -- a quiz labelled industrial could ground in blockchain chunks). Omitted routes automatically via app.services.routing, same as chat -- see QuizResponse.domain_source."
          },
          "language": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Language"
              },
              {
                "type": "null"
              }
            ],
            "description": "Quiz language. Explicit value is authoritative; omitted falls back to detecting the language from the topic text."
          }
        },
        "type": "object",
        "required": [
          "topic"
        ],
        "title": "QuizRequest"
