# ─────────────────────────────────────────────────────────────────────────────
# Environment overrides for the RTX 5090 deployment.
# These map 1:1 to app/config.py fields (pydantic-settings reads the UPPERCASE
# name). In the Akash SDL they live under each service's `env:` block; this file
# is the reference / a `docker run --env-file` source for local GPU testing.
# NOT committed with real secrets — see .gitignore (.env.*).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (change the password!) ─────────────────────────────────────────
POSTGRES_USER=assistant
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=iblog_assistant
DATABASE_URL=postgresql://assistant:CHANGE_ME_strong_password@db:5432/iblog_assistant

# ── Ollama (models are baked in; these are the tags the app requests) ────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=IBLOG_TUTOR:latest
OLLAMA_MODEL_FR=iblog-tutor-fr:latest
# Model weights are fetched at boot onto the /models volume (NOT baked into the
# image). Host the two GGUFs from config/models/ somewhere with a direct URL
# (HF repo, S3/Backblaze pre-signed, etc.) and set these. One-time download per
# fresh volume. Stem->var mapping is fixed by entrypoint.sh.
IBLOG_TUTOR_GGUF_URL=https://huggingface.co/Oussamamaat/iblog-tutor-gguf/resolve/main/IBLOG_TUTOR.gguf
IBLOG_TUTOR_FR_GGUF_URL=https://huggingface.co/Oussamamaat/iblog-tutor-gguf/resolve/main/iblog-tutor-fr.gguf
# The repo above is private, so the boot-time download needs a Bearer token.
# Fine-grained READ token scoped to that repo — never the write token.
HF_TOKEN=
# 32 GB card: pin both tutors resident for the whole process lifetime (no
# per-language-switch reload — the headline win this deploy proves).
OLLAMA_KEEP_ALIVE=-1

# ── Linux venv interpreters (app/config.py defaults are Windows paths) ───────
OCR_VENV_PYTHON=/app/.ocr_venv/bin/python
STT_VENV_PYTHON=/app/.speech_venv/bin/python

# ── Voice pipeline — set OFF "none" to enable + benchmark ────────────────────
# STT: faster-whisper (whisper) is lighter/French-strong; seamless targets
# Darija "ary". Provision both in the image; pick per bench run.
STT_ENGINE=none
STT_MODEL=large-v3
TTS_ENGINE=none
TTS_VOICE_FR=fr_FR-siwis-medium
TTS_VOICE_AR=ar_JO-kareem-medium
TTS_VOICE_DIR=/app/data/tts_voices
# 32 GB: never release the STT worker's VRAM (0 = keep resident).
SPEECH_WORKER_IDLE_RELEASE_SECONDS=0

# ── OCR (best-effort on Blackwell) ───────────────────────────────────────────
# paddleocr if paddlepaddle-gpu built for sm_120; else set to "none".
OCR_ENGINE=paddleocr
OCR_PADDLE_ENGINE=vl
OCR_KEEP_RESIDENT=true
OCR_WORKER_IDLE_RELEASE_SECONDS=0

# ── Embeddings (raise batch on the bigger card) ──────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=128

# ── Retrieval / safety ───────────────────────────────────────────────────────
RETRIEVAL_BACKEND=pgvector
UPLOADS_READ_ONLY=true

# ── Entrypoint behavior ──────────────────────────────────────────────────────
WARM_MODELS=1
