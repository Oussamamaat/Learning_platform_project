# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.gguf_venv/
# OCR engines pin their own incompatible torch/paddle runtimes, so they get a
# dedicated venv rather than sharing .gguf_venv (see config/requirements-ocr.txt)
.ocr_venv/
# STT engines (faster-whisper/SeamlessM4T) likewise get a dedicated venv
# (see config/requirements-speech.txt)
.speech_venv/

# GGUF weights extracted for baking into the GPU image
# (scripts/docker/prepare_models.py) -- multi-GB build inputs, not source.
# The tiny .Modelfile text files ARE tracked: config/Dockerfile.gpu's
# `COPY config/models/*.Modelfile /models/` needs them present in CI checkouts,
# which never run prepare_models.py.
config/models/*
!config/models/*.Modelfile

# Benchmark harness outputs (scripts/benchmark/, scripts/eval_*.py)
benchmark_report.md
benchmark_*.json
scripts/eval_stt_results.json
scripts/eval_tts_results.json

# Environment / secrets
.env
.env.*

# Node / frontend
frontend/node_modules/
frontend/dist/

# Generated model weights & compile caches (multi-GB, reproducible from adapter + base model)
atlas_gguf_export*/
unsloth_compiled_cache/

# Tenant-uploaded documents (settings.upload_dir). Runtime data, not source:
# each file is reachable only via its source_files row, and the rows live in
# Postgres -- committing the blobs would leak one tenant's corpus into the repo.
data/uploads/

# Superseded exports/datasets kept locally for comparison only (see CLAUDE.md)
_archive/

# Downloaded font assets (not project source)
Inter,JetBrains_Mono,Outfit,Plus_Jakarta_Sans/

# Editor/agent local-only state
.claude/settings.local.json

# Deployment secrets. akash.env and the *.local.yaml SDL carry the real Postgres
# password and the HuggingFace READ token used to fetch the GGUFs at boot; only
# the placeholder template (deploy/akash-deploy.yaml) belongs in git.
deploy/akash.env
deploy/*.local.yaml

# OS
Thumbs.db
.DS_Store

# Batch-generation output (scripts/generate_video_samples.py etc.) -- runtime
# artifacts, not source. The .raw.jsonl debugging log especially must never
# be sent to the partner or committed.
out/

*.pdf
# Exception: the OCR bench/ingest-timing fixture used by the Akash test plan
# (docs/deploy/lease-03-phase3.sh) -- git-cloned into the lease container since
# it isn't baked into the image. Every other *.pdf (tenant uploads etc.) stays
# ignored.
!/arabic_test.pdf